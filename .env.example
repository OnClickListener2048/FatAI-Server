# Network requests honor http_proxy and https_proxy from the process environment.
ENVIRONMENT=development
DOCLING_SERVER_URL=http://127.0.0.1:5001
# Set false before exposing the server; JSON localPath input only exists for the desktop migration.
ALLOW_LOCAL_DOCUMENT_PATHS=true
DEFAULT_CHAT_MODEL=gpt-4o-mini
# Provider API keys are configured by each user in the FatAI client and stored encrypted in the database.
# Keep JWT_SECRET stable: it is used to encrypt those user-owned provider keys at rest.
JWT_SECRET=4f2b486fa7084af5b60ac907c5e20cef
# RAG: OpenAI-compatible embedding endpoint (default local Ollama bge-m3, 1024 dims).
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_TOP_K_MEMORY=8
RAG_TOP_K_DOCUMENT=5
RAG_MIN_SCORE=0.45
RAG_CHUNK_CHARS=800
RAG_SWEEP_SECONDS=5.0
